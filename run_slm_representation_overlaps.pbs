#!/bin/bash
#PBS -N slm_ntp_overlaps
#PBS -q gpuq-longrun
#PBS -l select=1:ncpus=4:ngpus=1:mem=64gb
#PBS -l walltime=1000:00:00
#PBS -j oe
#PBS -o pbs_logs/

set -eo pipefail

# =============================================================================
# Paths
# =============================================================================

REPO_DIR="${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}"
SOURCE_DIR="${SOURCE_DIR:-$REPO_DIR/SLM}"
RUN_SCRIPT="${RUN_SCRIPT:-$REPO_DIR/compute_slm_ntp_overlaps.py}"
DATA_ROOT="${DATA_ROOT:-$REPO_DIR/data}"
COLLECTED_RESULTS_ROOT="${COLLECTED_RESULTS_ROOT:-$REPO_DIR/collected_results}"

# =============================================================================
# Run selection
# =============================================================================

# Legacy interface: SAVE_NAME selects training data; RUN_NAME names the output.
# New interface (without SAVE_NAME): RUN_NAME selects training data and
# OUTPUT_NAME names the output. Explicit OUTPUT_NAME always takes precedence.
if [ -n "${SAVE_NAME:-}" ]; then
    TRAIN_RUN_NAME="$SAVE_NAME"
    OUTPUT_NAME="${OUTPUT_NAME:-${RUN_NAME:-}}"
else
    TRAIN_RUN_NAME="${RUN_NAME:-slm_uniform_L3_v1}"
fi
RUN_ID="${RUN_ID:-rhm_transformer_v2_P_65536_seed_rules_1_seed_sample_1_seed_model_1}"
RUN_DIR="${RUN_DIR:-}"              # Optional leaf path; overrides training selection.
OUTPUT_NAME="${OUTPUT_NAME:-}"      # Empty -> automatic name.

# =============================================================================
# Choose ONE overlap definition
# =============================================================================
#
# weights             : existing cosine weight overlap
# cka                 : CKA of residual-stream states h_l
# block_update_cka    : CKA of literal block writes h_l-h_{l-1}
# low_rank            : finite-rank sample-space subspace overlap
# novelty             : CKA of h_l minus the train-fitted linear prediction from h_{l-1}
# task                : CKA of the train-fitted next-token-predictive representation H W
#
OVERLAP_DEFINITION="${OVERLAP_DEFINITION:-cka}"

# =============================================================================
# Common checkpoint/reference parameters
# =============================================================================

REFERENCE_SOURCE="${REFERENCE_SOURCE:-auto}"   # auto | saved | generate (RHM only).
SUBSET_TRAIN_SIZE="${SUBSET_TRAIN_SIZE:-512}" # Used to fit novelty/task maps.
SUBSET_VALID_SIZE="${SUBSET_VALID_SIZE:-512}" # Held-out overlap evaluation set.
SUBSET_SEED="${SUBSET_SEED:-12345}"
BATCH_SIZE="${BATCH_SIZE:-256}"               # Transformer forward batch size.

NUM_CHECKPOINTS="${NUM_CHECKPOINTS:-0}"       # 0 = every checkpoint; >0 = log-spaced subset.
MAX_STEP="${MAX_STEP:-}"                      # Optional maximum checkpoint step.

INCLUDE_EMBEDDING="${INCLUDE_EMBEDDING:-1}"  # cka / low_rank / task.
INCLUDE_FINAL_NORM="${INCLUDE_FINAL_NORM:-1}"  # cka / low_rank / task.

TEMP_ROOT="${TEMP_ROOT:-}"                    # Optional scratch directory.
KEEP_TEMP="${KEEP_TEMP:-0}"                   # 1 keeps temporary representations/matrices.

# =============================================================================
# CASE: cka or block_update_cka
# =============================================================================

CKA_METRIC="${CKA_METRIC:-gram}"              # gram | feature

# =============================================================================
# CASE: low_rank
# =============================================================================
# q_r(t,t') = ||Q_r(t)^T Q_r(t')||_F^2 / r on the held-out validation set.
# The randomized SVD is only an extraction step; no learned readout is fitted.

LOW_RANK_RANK="${LOW_RANK_RANK:-8}"
LOW_RANK_OVERSAMPLE="${LOW_RANK_OVERSAMPLE:-8}"
LOW_RANK_POWER_ITERS="${LOW_RANK_POWER_ITERS:-1}"
LOW_RANK_POSITION_CHUNK="${LOW_RANK_POSITION_CHUNK:-8}"

# =============================================================================
# CASE: novelty
# =============================================================================
# For each checkpoint t and block l, ONE A_l(t) is fitted on the training
# reference, pooling all token positions:
#     h_l ~= mean_y + (h_{l-1}-mean_x) A_l(t)
# The held-out residual is then compared by Gram CKA across checkpoints.
# The ridge objective uses mean MSE + alpha * ||A||_F^2.

NOVELTY_RIDGE_ALPHA="${NOVELTY_RIDGE_ALPHA:-1e-4}"

# =============================================================================
# CASE: task
# =============================================================================
# For each checkpoint t and representation layer l, ONE W_l(t) is fitted on the
# training reference, pooling all token positions, to predict x_{i+1} from h_i.
# Validation CKA is computed in task-output space without materialising the full
# [samples,vocab] output at every position.
# The ridge objective uses mean MSE + alpha * ||W||_F^2.

TASK_RIDGE_ALPHA="${TASK_RIDGE_ALPHA:-1e-4}"

# =============================================================================
# Shared numerical parameters for low_rank / novelty / task
# =============================================================================

LINEAR_FIT_DEVICE="${LINEAR_FIT_DEVICE:-cuda}" # cuda | cpu | auto
LINEAR_FIT_DTYPE="${LINEAR_FIT_DTYPE:-float64}" # float64 | float32
LINEAR_FIT_CHUNK_ROWS="${LINEAR_FIT_CHUNK_ROWS:-65536}"

# =============================================================================
# Runtime
# =============================================================================

CONDA_ENV_NAME="${CONDA_ENV_NAME:-rhm}"
PYTHON_BIN="${PYTHON_BIN:-python}"
DEVICE="${DEVICE:-cuda}"

JOB_ID="${PBS_JOBID:-no_jobid}"
mkdir -p "$REPO_DIR/pbs_logs" "$COLLECTED_RESULTS_ROOT"
cd "$REPO_DIR"
JOB_LOG="$REPO_DIR/pbs_logs/slm_ntp_overlaps_${JOB_ID}.log"

if command -v module >/dev/null 2>&1; then
    module purge || true
fi

export OMP_NUM_THREADS="${OMP_NUM_THREADS:-4}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-1}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"
export MKL_INTERFACE_LAYER="${MKL_INTERFACE_LAYER:-GNU}"

if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
    conda activate "$CONDA_ENV_NAME"
else
    source activate "$CONDA_ENV_NAME"
fi

set -u

# Some PBS installations expose a UUID rather than a numeric CUDA index.
ORIGINAL_CVD="${CUDA_VISIBLE_DEVICES:-unset}"
if [[ "$ORIGINAL_CVD" == GPU-* ]]; then
    GPU_INDEX="$(
        "$PYTHON_BIN" - <<'PY'
import os, subprocess
uuid = os.environ.get("CUDA_VISIBLE_DEVICES", "").strip()
rows = subprocess.check_output(
    ["nvidia-smi", "--query-gpu=index,uuid", "--format=csv,noheader"],
    text=True,
)
for row in rows.splitlines():
    index, full_uuid = [item.strip() for item in row.split(",")]
    if full_uuid == uuid or full_uuid.startswith(uuid):
        print(index)
        break
PY
    )"
    if [ -n "$GPU_INDEX" ]; then
        export CUDA_VISIBLE_DEVICES="$GPU_INDEX"
    fi
fi

if [ -n "$RUN_DIR" ]; then
    RESOLVED_RUN_DIR="$RUN_DIR"
else
    RESOLVED_RUN_DIR="$DATA_ROOT/$TRAIN_RUN_NAME/$RUN_ID"
fi

bool_arg() {
    local value="${1,,}"
    local yes_flag="$2"
    local no_flag="$3"
    case "$value" in
        1|true|yes|y|on) printf '%s' "$yes_flag" ;;
        0|false|no|n|off) printf '%s' "$no_flag" ;;
        *)
            echo "[ERROR] invalid boolean value: $1" >&2
            return 2
            ;;
    esac
}

{
    echo "[START] $(date '+%Y-%m-%d %H:%M:%S')"
    echo "[INFO] host=$(hostname)"
    echo "[INFO] repo_dir=$REPO_DIR"
    echo "[INFO] source_dir=$SOURCE_DIR"
    echo "[INFO] run_script=$RUN_SCRIPT"
    echo "[INFO] resolved_run_dir=$RESOLVED_RUN_DIR"
    echo "[INFO] output_name=${OUTPUT_NAME:-auto}"
    echo "[INFO] overlap_definition=$OVERLAP_DEFINITION"
    echo "[INFO] checkpoints: num=$NUM_CHECKPOINTS max_step=${MAX_STEP:-none}"
    echo "[INFO] references: train=$SUBSET_TRAIN_SIZE valid=$SUBSET_VALID_SIZE seed=$SUBSET_SEED source=$REFERENCE_SOURCE"
    echo "[INFO] batch_size=$BATCH_SIZE"
    echo "[INFO] cka_metric=$CKA_METRIC"
    echo "[INFO] low_rank: rank=$LOW_RANK_RANK oversample=$LOW_RANK_OVERSAMPLE power_iters=$LOW_RANK_POWER_ITERS position_chunk=$LOW_RANK_POSITION_CHUNK"
    echo "[INFO] novelty_ridge_alpha=$NOVELTY_RIDGE_ALPHA"
    echo "[INFO] task_ridge_alpha=$TASK_RIDGE_ALPHA"
    echo "[INFO] linear_fit: device=$LINEAR_FIT_DEVICE dtype=$LINEAR_FIT_DTYPE chunk_rows=$LINEAR_FIT_CHUNK_ROWS"
    echo "[INFO] model device=$DEVICE"
    echo "[INFO] original_cuda_visible_devices=$ORIGINAL_CVD"
    echo "[INFO] cuda_visible_devices=${CUDA_VISIBLE_DEVICES:-unset}"
    "$PYTHON_BIN" - <<'PY' || true
import torch
print("[INFO] torch=", torch.__version__)
print("[INFO] cuda_available=", torch.cuda.is_available())
if torch.cuda.is_available():
    print("[INFO] gpu=", torch.cuda.get_device_name(0))
PY
} | tee -a "$JOB_LOG"

if [ ! -f "$RUN_SCRIPT" ]; then
    echo "[ERROR] Missing overlap script: $RUN_SCRIPT" | tee -a "$JOB_LOG"
    exit 1
fi
if [ ! -f "$REPO_DIR/compute_slm_representation_overlaps.py" ]; then
    echo "[ERROR] Missing reused base script: $REPO_DIR/compute_slm_representation_overlaps.py" | tee -a "$JOB_LOG"
    exit 1
fi
if [ ! -d "$SOURCE_DIR" ]; then
    echo "[ERROR] Missing source directory: $SOURCE_DIR" | tee -a "$JOB_LOG"
    exit 1
fi
if [ ! -d "$RESOLVED_RUN_DIR/checkpoints" ]; then
    echo "[ERROR] Missing checkpoint directory: $RESOLVED_RUN_DIR/checkpoints" | tee -a "$JOB_LOG"
    exit 1
fi

case "$OVERLAP_DEFINITION" in
    weights|cka|block_update_cka|low_rank|novelty|task|stage1) ;;
    *)
        echo "[ERROR] Unknown OVERLAP_DEFINITION=$OVERLAP_DEFINITION" | tee -a "$JOB_LOG"
        exit 1
        ;;
esac

# =============================================================================
# Build one command. Only parameters relevant to the selected case are added.
# =============================================================================

CMD=(
    "$PYTHON_BIN" -u "$RUN_SCRIPT"
    --repo_dir "$REPO_DIR"
    --source_dir "$SOURCE_DIR"
    --data_root "$DATA_ROOT"
    --collected_results_root "$COLLECTED_RESULTS_ROOT"
    --device "$DEVICE"
    --overlap_definition "$OVERLAP_DEFINITION"
    --reference_source "$REFERENCE_SOURCE"
    --subset_train_size "$SUBSET_TRAIN_SIZE"
    --subset_valid_size "$SUBSET_VALID_SIZE"
    --subset_seed "$SUBSET_SEED"
    --batch_size "$BATCH_SIZE"
    --num_checkpoints "$NUM_CHECKPOINTS"
)

if [ -n "$RUN_DIR" ]; then
    CMD+=(--run_dir "$RUN_DIR")
else
    CMD+=(--run_name "$TRAIN_RUN_NAME" --run_id "$RUN_ID")
fi
if [ -n "$OUTPUT_NAME" ]; then
    CMD+=(--output_name "$OUTPUT_NAME")
fi
if [ -n "$MAX_STEP" ]; then
    CMD+=(--max_step "$MAX_STEP")
fi
if [ -n "$TEMP_ROOT" ]; then
    CMD+=(--temp_root "$TEMP_ROOT")
fi

CMD+=("$(bool_arg "$KEEP_TEMP" --keep_temp --no-keep_temp)")

case "$OVERLAP_DEFINITION" in
    stage1)
        CMD+=(
            --stage1_alphas "${STAGE1_ALPHAS:-1e-5,1e-4,1e-3}"
            --stage1_ranks "${STAGE1_RANKS:-8,16}"
            --stage1_rank_rtol "${STAGE1_RANK_RTOL:-1e-5}"
            --novelty_ridge_alpha "$NOVELTY_RIDGE_ALPHA"
            --linear_fit_device "$LINEAR_FIT_DEVICE"
            --linear_fit_chunk_rows "$LINEAR_FIT_CHUNK_ROWS"
            "$(bool_arg "${STAGE1_LOSS:-1}" --stage1_loss --no-stage1_loss)"
        )
        ;;
    cka)
        CMD+=(
            --cka_metric "$CKA_METRIC"
            "$(bool_arg "$INCLUDE_EMBEDDING" --include_embedding --no-include_embedding)"
            "$(bool_arg "$INCLUDE_FINAL_NORM" --include_final_norm --no-include_final_norm)"
        )
        ;;

    block_update_cka)
        CMD+=(--cka_metric "$CKA_METRIC")
        ;;

    low_rank)
        CMD+=(
            --low_rank_rank "$LOW_RANK_RANK"
            --low_rank_oversample "$LOW_RANK_OVERSAMPLE"
            --low_rank_power_iters "$LOW_RANK_POWER_ITERS"
            --low_rank_position_chunk "$LOW_RANK_POSITION_CHUNK"
            --linear_fit_device "$LINEAR_FIT_DEVICE"
            "$(bool_arg "$INCLUDE_EMBEDDING" --include_embedding --no-include_embedding)"
            "$(bool_arg "$INCLUDE_FINAL_NORM" --include_final_norm --no-include_final_norm)"
        )
        ;;

    novelty)
        CMD+=(
            --novelty_ridge_alpha "$NOVELTY_RIDGE_ALPHA"
            --linear_fit_device "$LINEAR_FIT_DEVICE"
            --linear_fit_dtype "$LINEAR_FIT_DTYPE"
            --linear_fit_chunk_rows "$LINEAR_FIT_CHUNK_ROWS"
        )
        ;;

    task)
        CMD+=(
            --task_ridge_alpha "$TASK_RIDGE_ALPHA"
            --linear_fit_device "$LINEAR_FIT_DEVICE"
            --linear_fit_dtype "$LINEAR_FIT_DTYPE"
            --linear_fit_chunk_rows "$LINEAR_FIT_CHUNK_ROWS"
            "$(bool_arg "$INCLUDE_EMBEDDING" --include_embedding --no-include_embedding)"
            "$(bool_arg "$INCLUDE_FINAL_NORM" --include_final_norm --no-include_final_norm)"
        )
        ;;

    weights)
        ;;
esac

{
    echo "[CMD] ${CMD[*]}"
    echo "[RUN] launching NTP overlap computation"
} | tee -a "$JOB_LOG"

"${CMD[@]}" 2>&1 | tee -a "$JOB_LOG"
RETURN_CODE=${PIPESTATUS[0]}

echo "[END] $(date '+%Y-%m-%d %H:%M:%S') return_code=$RETURN_CODE" | tee -a "$JOB_LOG"
exit "$RETURN_CODE"
